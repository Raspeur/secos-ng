void init_paging()
{

   // IDENTITY MAPPING FOR RING3 KERNEL

   // TP4 Q2                          // 0x001 (10bits) -- 0x300 (10bits) -- 0x000 (12 bits)
   pde32_t *pgd = (pde32_t *)0x600000; // 00 0000 0001   -- 10 0000 0000   -- 0000 0000 0000
   set_cr3((uint32_t)pgd);
   // TP4 Q4
   pte32_t *ptb = (pte32_t *)0x601000;
   // end Q4
   // TP4 Q5
   for (int i = 0; i < 1024; i++)
   {
      pg_set_entry(&ptb[i], PG_KRN | PG_RW, i);
   }
 	memset((void*)pgd, 0, PAGE_SIZE);
	pg_set_entry(&pgd[0], PG_KRN|PG_RW, page_get_nr(ptb));
   // end Q5

   // ACTIVATE PAGING
   uint32_t cr0 = get_cr0();
   set_cr0(cr0 | CR0_PG);


   // prepare CR3 and PGD and PTB for user tasks
   pde32_t *user_pgd = (pde32_t *)0x1600000; // User PGD
   pte32_t *user_ptb = (pte32_t *)0x1601000; // User PTB
   for (int i = 0; i < 1024; i++)
   {
      pg_set_entry(&user_ptb[i], PG_USR | PG_RW, i);
   }
   memset((void *)user_pgd, 0, PAGE_SIZE);
   pg_set_entry(&user_pgd[0], PG_USR | PG_RW, page_get_nr(user_ptb));
   /* for (int i = 0; i < NUMBER_OF_TASKS; i++)
   {
      Task_Context[i].cr3 = (uint32_t)user_pgd;
      Task_Context[i].gpr.esp = 0x100000 + (i + 1) * 0x4000; // User stack
   }      */
}

    // Set timer periodicity to 100ms
   /* void  pit_set_periodicity(int period_ms)
   {
      // PIT frequency = 1193182 Hz
      // period_ms in milliseconds
      uint16_t count = (uint16_t)((1193182 * period_ms) / 1000);

      // Set PIT to mode 2 (rate generator), binary mode
      outb(0x43, 0x34); // Channel 0, access mode lobyte/hibyte, mode 2, binary

      // Set reload count
      outb(0x40, (uint8_t)(count & 0xFF));       // Low byte
      outb(0x40, (uint8_t)((count >> 8) & 0xFF)); // High byte
   }    */

void tp() {
   // disable interruptions
    asm volatile("cli");   

    
    // init paging for kernel and user tasks
    //init_paging();


    // TP5 Q1 : FLAT MODEL FOR SEGMENTS
    init_gdt();
    set_ds(d3_sel);
    set_es(d3_sel);
    set_fs(d3_sel);
    set_gs(d3_sel);
    TSS.s0.esp = get_ebp();
    TSS.s0.ss  = d0_sel;
    tss_dsc(&GDT[ts_idx], (offset_t)&TSS);
    set_tr(ts_sel);
    // end Q1

    

    // TP5 Q2 : install syscall at IRG 0x80
    int_desc_t *dsc;
    idt_reg_t  idtr;
    get_idtr(idtr);
    dsc = &idtr.desc[0x80];
    dsc->offset_1 = (uint16_t)((uint32_t)syscall_isr); // 3 install kernel syscall handler
    dsc->offset_2 = (uint16_t)(((uint32_t)syscall_isr)>>16);
    // end Q2 
    // TP5 Q3
    dsc->dpl = 3;
    // end Q3
    

    // TP5 Q2 : install Timer IRQ at 0x20
    dsc = &idtr.desc[0x20];
    dsc->offset_1 = (uint16_t)((uint32_t)timer_isr); // 3 install kernel timer handler
    dsc->offset_2 = (uint16_t)(((uint32_t)timer_isr)>>16);
    // end Q2

    // TP5 Q3
    // dsc->dpl = 0;
    // end Q3
    
    // Set timer periodicity to 100ms
    //pit_set_periodicity(1000); 
// enable interruptions
      asm volatile("sti");

    // START first user task in ring 3
    // uint32_t   ustack = Task_Context[0].gpr.esp;
    uint32_t   ustack = 0x600000;
    asm volatile (
      "push %0 \n" // ss
      "push %1 \n" // esp pour du ring 3 !
      "pushf   \n" // eflags
      "push %2 \n" // cs
      "push %3 \n" // eip
      "iret"
      ::
       "i"(d3_sel),
       "m"(ustack),
       "i"(c3_sel),
       "r"(&user0)
      );
    // end common
}
